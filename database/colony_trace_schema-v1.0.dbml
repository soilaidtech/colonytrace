
enum roles { 
    admin
    operations_manager
    operator
    production_manager
    director
}

enum waste_type_enum {
    food_waste
    agricultural_waste
    industrial_waste
    plastic_waste
    residential_waste
    other
}

enum contamination_level_enum {
    low
    medium
    high
}

enum cage_status_enum {
    full
    empty
    maintenance
    active
}

enum breeder_source_enum {
    internal
    external
}

enum status_enum {
    active
    inactive
    completed
    pending
}

enum larvae_source_enum {
    internal
    external
}

enum product_type_enum {
    dried_larvae
    frass
    prepupae
    wet_larvae
    other
}

enum packaging_status_enum {
    packaged
    unpackaged
    in_progress
}

enum customer_type_enum {
    chicken_farm
    fish_farm
    pig_farm
    feed_miller
    crop_farm
    tree_plantation
    other
}

enum payment_status_enum {
    paid
    unpaid
    pending
}

enum movement_type_enum {
    addition
    removal
    transfer
}

enum customer_status_enum {
    active
    inactive
    pending
}

enum trip_status_enum {
    scheduled
    in_progress
    completed
    cancelled
}

enum expense_category_enum {
    fuel
    driver_payment
    collector_payment
    labour
    drying_fuel
    packaging
    maintenance
    transport
    utilities
    equipment
    other
}

Table Employee {
    employee_id int [pk]
    first_name varchar [not null]
    role roles
    job_title varchar [not null]
    email varchar [not null]
    status status_enum [not null]
    phone_number varchar [not null]
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table Trip {
    trip_id int [pk]
    vehicle_id varchar [not null]
    driver_id int [ref: > Employee.employee_id]
    source_location varchar [not null]
    trip_status trip_status_enum
    dispatch_time timestamp [not null]
    return_time timestamp [null]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table WasteReceivingEvent {
    receiving_id int [pk]
    trip_id int [ref: > Trip.trip_id]
    received_date timestamp [not null]
    waste_source varchar [not null]
    waste_type waste_type_enum
    gross_weight float [not null]
    contamination_level contamination_level_enum
    waste_accepted boolean [not null]
    received_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table WasteSortingEvent {
    sorting_id int [pk]
    receiving_id int [ref: > WasteReceivingEvent.receiving_id]
    sorted_date timestamp [not null]
    feedstock_weight float [not null]
    compost_weight float [not null]
    plastic_weight float [not null]
    reject_weight float [not null]
    storage_container_id varchar [not null]
    sorted_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table WasteBatch{
    waste_batch_id int [pk]
    sorting_id int [ref: > WasteSortingEvent.sorting_id]
    batch_weight float [not null]
    created_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table Recipe {
    recipe_id int [pk]
    recipe_name varchar [not null]
    total_weight float [not null]
    prepared_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table RecipeIngredient {
    ingredient_id int [pk]
    recipe_id int [ref: > Recipe.recipe_id, not null]
    ingredient_name varchar [not null]
    ingredient_weight float [not null]
    waste_batch_id int [ref: > WasteBatch.waste_batch_id, null]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table BreedingCage {
    breeding_cage_id int [pk]
    cage_identifier varchar [not null]
    cage_status cage_status_enum
    created_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table BreedingBatch {
    breeding_batch_id int [pk]
    start_date timestamp [not null]
    retirement_date timestamp
    prepupae_weight float [not null]
    source_type breeder_source_enum
    breeding_cage_id int [ref: > BreedingCage.breeding_cage_id]
    status status_enum
    created_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table EggCollectionEvent {
    egg_collection_id int [pk]
    breeding_cage_id int [ref: > BreedingCage.breeding_cage_id]
    eggie_placement_date timestamp [not null]
    collection_date timestamp [not null]
    empty_eggie_weight float [not null]
    full_eggie_weight float [not null]
    collected_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table NurseryBatch {
    nursery_batch_id int [pk]
    egg_collection_id int [ref: > EggCollectionEvent.egg_collection_id]
    start_date timestamp [not null]
    status status_enum
    created_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table LarvaeBatch {
    larvae_batch_id int [pk]
    nursery_batch_id int [ref: > NurseryBatch.nursery_batch_id, null]
    container_identifier varchar
    start_date timestamp [not null]
    initial_weight float [not null]
    batch_status status_enum
    batch_source larvae_source_enum
    external_source varchar
    created_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table FeedingEvent {
    feeding_event_id int [pk]
    larvae_batch_id int [ref: > LarvaeBatch.larvae_batch_id, null]
    nursery_batch_id int [ref: > NurseryBatch.nursery_batch_id, null]
    recipe_id int [ref: > Recipe.recipe_id]
    feed_date timestamp [not null]
    larvae_weight float [not null]
    feed_weight float [not null]
    feeding_ratio float [not null]
    fed_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table HarvestEvent {
    harvest_event_id int [pk]
    larvae_batch_id int [ref: > LarvaeBatch.larvae_batch_id, not null]
    harvest_batch_id int [ref: > HarvestBatch.harvest_batch_id, null]
    harvest_date timestamp [not null]
    harvested_by int [ref: > Employee.employee_id]
    harvest_reason varchar [not null]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table HarvestBatch {
    harvest_batch_id int [pk]
    wet_larvae_weight float [not null]
    prepupae_weight float [not null]
    frass_weight float [not null]
    reject_weight float [not null]
    contribution_notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table DryingEvent {
    drying_event_id int [pk]
    harvest_batch_id int [ref: > HarvestBatch.harvest_batch_id, not null]
    dried_larvae_batch_id int [ref: > DriedLarvaeBatch.dried_larvae_batch_id, not null]
    dryer_id varchar [not null]
    drying_date timestamp [not null]
    wet_input_weight float [not null]
    dried_output_weight float [not null]
    start_time timestamp [not null]
    stop_time timestamp [not null]
    duration_minutes int [not null]
    moisture_content float [not null]
    dried_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table DriedLarvaeBatch {
    dried_larvae_batch_id int [pk]
    batch_date timestamp [not null]
    total_dried_weight float [not null]
    created_by int [ref: > Employee.employee_id, not null]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table ProductBatch {
    product_batch_id int [pk]
    product_id int [ref: > Product.product_id, not null]
    dried_larvae_batch_id int [ref: > DriedLarvaeBatch.dried_larvae_batch_id, null]
    harvest_batch_id int [ref: > HarvestBatch.harvest_batch_id, null]
    production_date timestamp [not null]
    quantity_produced float [not null]
    quantity_available float [not null]
    packaging_status packaging_status_enum
    created_by int [ref: > Employee.employee_id]
    product_batch_expiry timestamp
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table Product {
    product_id int [pk]
    product_name varchar [not null]
    product_type product_type_enum
    unit_of_measure varchar [not null]
    unit_price decimal(12,2) [not null]
    package_size float [not null]
    batch_status status_enum
    created_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table Customer {
    customer_id int [pk]
    customer_name varchar [not null]
    customer_type customer_type_enum
    email varchar
    phone_number varchar [not null]
    location varchar [not null]
    status customer_status_enum
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table ProductSale {
    sale_id int [pk]
    customer_id int [ref: > Customer.customer_id]
    product_batch_id int [ref: > ProductBatch.product_batch_id]
    sale_date timestamp [not null]
    quantity_sold float [not null]
    unit_price decimal(12,2) [not null]
    total_price decimal(12,2) [not null]
    payment_status payment_status_enum
    sold_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table InventoryMovement {
    inventory_movement_id int [pk]
    product_batch_id int [ref: > ProductBatch.product_batch_id]
    movement_date timestamp [not null]
    quantity_moved float [not null]
    moved_by int [ref: > Employee.employee_id]
    reason_for_movement varchar [not null]
    movement_type movement_type_enum
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}

Table Expense {
    expense_id int [pk]
    expense_date timestamp [not null]
    amount decimal(12,2) [not null]
    category expense_category_enum
    trip_id int [ref: > Trip.trip_id, null]
    drying_event_id int [ref: > DryingEvent.drying_event_id, null]
    product_batch_id int [ref: > ProductBatch.product_batch_id, null]
    description varchar
    incurred_by int [ref: > Employee.employee_id]
    notes varchar
    created_at timestamp [not null]
    updated_at timestamp [not null]
}